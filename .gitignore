# Python build artifacts (anchored to repo root so they can't shadow a
# same-named source package, e.g. a future src/rtp/env/ or src/rtp/build/).
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/

# Virtual environments
.venv/
venv/
/env/

# Secrets
.env

# Locked deps (regenerate locally)
requirements.lock.txt

# Generated artifacts: scenes, episode logs, videos
# Anchored to repo root so it does NOT match the src/rtp/data/ package.
/data/
*.hdf5
*.h5
*.mp4
*.pkl

# Vendored MuJoCo Menagerie assets (downloaded via scripts, not committed)
assets/menagerie/franka_emika_panda/

# OS / editor
.DS_Store
.idea/
.vscode/

# Tooling caches
.pytest_cache/
.ruff_cache/
